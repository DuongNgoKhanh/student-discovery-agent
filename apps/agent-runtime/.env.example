# Provider credentials (placeholders only)
GOOGLE_API_KEY=
OPENAI_API_KEY=
# OpenAI-compatible vLLM endpoint (LiteLLM proxy): chat ref `vllm/<model id>` and vLLM embedding models
VLLM_API_KEY=
VLLM_BASE_URL=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_EMBEDDING_MODEL=text-embedding-004
# Comma-separated: gemini-embedding-2, nomic-embed-text-v1.5, multilingual-e5-large (keep in sync with Studio)
KNOWLEDGE_EMBEDDING_MODELS=gemini-embedding-2
KNOWLEDGE_RETRIEVAL_TIMEOUT_MS=1500
# GITHUB_COPILOT_TOKEN=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# PROXY_HOST=
# PROXY_PORT=
LOG_LEVEL=INFO

# B-01 demo session runtime; supply each secret privately. No Product DATABASE_URL fallback.
RUNTIME_ENVIRONMENT=demo
RUNTIME_DATABASE_URL=
RUNTIME_SESSION_TTL_SECONDS=3600
RUNTIME_CONTENT_RETENTION_SECONDS=86400
RUNTIME_TRACE_RETENTION_SECONDS=86400
RUNTIME_INTERNAL_TOKEN_MAX_AGE_SECONDS=60
# JSON object {kid: canonical padded standard Base64 key}; each decoded key >=32 bytes.
RUNTIME_INTERNAL_KEYRING=
# Separate canonical padded standard Base64 key >=32 decoded bytes; never reuse a JWT key.
RUNTIME_CURSOR_SIGNING_KEY=
# Local development only: active releases from a directory (agent.json, experiences/<id>.json) instead of Product.
RUNTIME_LOCAL_RELEASES_DIR=
# Operator CLIs read their own process environment, not this .env file.
RUNTIME_MIGRATION_DATABASE_URL=
RUNTIME_CLEANUP_DATABASE_URL=
# Knowledge: indexer role (writes chunks/embeddings) and content-owner role for the demo seed
RUNTIME_KNOWLEDGE_INDEXER_DATABASE_URL=
RUNTIME_KNOWLEDGE_SEED_DATABASE_URL=
# Dedicated disposable PostgreSQL 16 server only; integration tests create/drop their own DBs/roles.
RUNTIME_TEST_ADMIN_DATABASE_URL=
