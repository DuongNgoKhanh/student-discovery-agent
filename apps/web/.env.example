# ============================================================================
# SDA Frontend — biến môi trường
# Tất cả biến dưới đây là SERVER-ONLY (browser gọi same-origin qua Route
# Handler nên không cần biến NEXT_PUBLIC cho API). Copy file này thành
# .env.local để chạy dev.
# ============================================================================

# URL gốc của FastAPI backend (bao gồm prefix /api/v1).
# - Chạy local (BE docker expose cổng 8081): http://localhost:8081/api/v1
# - Chạy chung docker-compose (service name "api"): http://api:8000/api/v1
API_BASE_URL=http://localhost:8081/api/v1

# Tên cookie lưu token (httpOnly). Thường không cần đổi.
AUTH_COOKIE_ACCESS=sda_access
AUTH_COOKIE_REFRESH=sda_refresh

NODE_ENV=development

# ---------------------------------------------------------------------------
# Product (Next.js route handlers) — chỉ bắt buộc khi Product DB/auth khởi tạo.
# KHÔNG đặt provider key ở web app.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/sda
# SECRET_KEY=change-me
# ACCESS_TOKEN_EXPIRE_MINUTES=11520
# REFRESH_TOKEN_EXPIRE_MINUTES=43200

# Admin login (/api/v1/admin/auth/login). KHÔNG có mật khẩu mặc định:
# nếu ADMIN_PASSWORD trống/không đặt thì admin login luôn trả 401.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-strong-admin-password

# Object storage (S3/MinIO) — chỉ parse khi dùng storage.
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
# S3_REGION=us-east-1
