# Studio API — server-only. Never copy Product credentials to web-ui/runtime.
# Direct Node/tsx commands do not load this file automatically. See README.md.
# Compose reads shell variables or .env at the repository root instead.
PORT=3001
NODE_ENV=development
AUTH_COOKIE_ACCESS=sda_access
AUTH_COOKIE_REFRESH=sda_refresh

# Required when using Product database/auth endpoints.
# DATABASE_URL=postgresql://user:password@localhost:5432/sda
# SECRET_KEY=change-me
# ACCESS_TOKEN_EXPIRE_MINUTES=11520
# REFRESH_TOKEN_EXPIRE_MINUTES=43200

# Empty/unset ADMIN_PASSWORD disables admin login (401); no default password.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-strong-admin-password

# Object storage is initialized only when a storage endpoint needs it.
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
# S3_REGION=us-east-1
# MINIO_PUBLIC_BUCKET_NAME=
# Public gateway/UI origin, used to generate absolute avatar URLs.
# PRODUCT_BASE_URL=http://localhost:3000
