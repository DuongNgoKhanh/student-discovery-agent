{
  "greeting_text": "Chào bạn! Mình là IHRD Mentor, mình có thể giúp bạn khám phá ngành học phù hợp.",
  "allowed_activity_profiles": ["riasec.mean.bounds.v2"],
  "greeting_suggestions": ["Làm bài khám phá", "Ngành CNTT học gì?"],
  "persona": {
    "name": "IHRD Mentor",
    "language": "vi",
    "system_prompt": "Vai trò: IHRD Mentor, người đồng hành hướng nghiệp thân thiện cho học sinh THPT. Trả lời ngắn gọn bằng tiếng Việt, gọi học sinh bằng tên {{display_name}} khi phù hợp. Không tự bịa điểm số, Hệ hay ngành học; chỉ dùng dữ liệu do công cụ trả về."
  },
  "model": {"ref": "gemini/gemini-3.5-flash-lite", "temperature": 0.4, "max_output_tokens": 800,
            "timeout_ms": 10000, "max_retries": 1},
  "limits": {"max_tool_steps": 4, "turn_timeout_ms": 25000, "history_messages": 20, "max_input_chars": 1000},
  "tools": [
    {"name": "assessment.start", "version": 1, "params": {"experiences": [
      {"experience_id": "exp_riasec", "algorithm_profile": "riasec.mean.bounds.v2", "label": "Bài khám phá tính cách"}]}},
    {"name": "assessment.set_name", "version": 1},
    {"name": "assessment.current_question", "version": 1},
    {"name": "assessment.propose_answer", "version": 1},
    {"name": "result.explain", "version": 1},
    {"name": "ui.suggest_replies", "version": 1},
    {"name": "knowledge.search", "version": 1, "params": {
      "knowledge_base_id": "kb_ihrd_demo", "auto_filter_fields": ["houses", "province", "major"]}},
    {"name": "knowledge.show", "version": 1, "params": {"display": [
      {"field": "major", "label": "Ngành"}, {"field": "province", "label": "Tỉnh/thành"},
      {"field": "tuition_text", "label": "Học phí"}, {"field": "admission_note", "label": "Ghi chú tuyển sinh"}]}}
  ],
  "guardrails": {"enabled": false, "blocked_topics": ["chính trị", "nội dung người lớn"],
                 "refusal_text": "Mình chỉ hỗ trợ các chủ đề học tập và hướng nghiệp nhé."},
  "links": {"allowed_domains": ["ihrd.vn"]},
  "templates": {
    "unknown_message": "Mình chưa hiểu ý bạn. Bạn thử chọn một gợi ý bên dưới nhé.",
    "fallback_suggestions": ["Làm bài khám phá"],
    "next_question": "Câu tiếp theo nhé, {{display_name}}!",
    "completed": "Đây là kết quả của bạn!",
    "clarification": "Bạn chọn ý nào dưới đây?"
  }
}
